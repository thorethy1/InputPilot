<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>InputPilotGitCommit</key>
	<string>$(INPUTPILOT_GIT_COMMIT)</string>
	<key>InputPilotUpdateChannel</key>
	<string>$(INPUTPILOT_CHANNEL)</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Connect InputPilot to your authorized ESP32-S3 device.</string>
	<key>CFBundleDisplayName</key>
	<string>InputPilot</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_http._tcp.</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>InputPilot discovers and controls ESP32 devices on your local network.</string>
</dict>
</plist>
