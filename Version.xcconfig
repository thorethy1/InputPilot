// Single source of truth for the public InputPilot app and firmware version.
// GitHub's Release workflow updates INPUTPILOT_VERSION. CI supplies the
// monotonically increasing INPUTPILOT_BUILD value for packaged iOS builds.
INPUTPILOT_VERSION = 0.8.18
INPUTPILOT_BUILD = 1

MARKETING_VERSION = $(INPUTPILOT_VERSION)
CURRENT_PROJECT_VERSION = $(INPUTPILOT_BUILD)
