// Single source of truth for InputPilot app, firmware and release identity.
// Release workflows update these values. CI supplies the monotonically
// increasing INPUTPILOT_BUILD value for packaged iOS builds.
INPUTPILOT_VERSION = 0.9.0
// Firmware/release identity. Beta builds use e.g. 0.9.0-beta.1 while the iOS
// marketing version remains the Apple-compatible numeric core above.
INPUTPILOT_RELEASE = 0.9.0-beta.5
INPUTPILOT_CHANNEL = beta
INPUTPILOT_BUILD = 2

MARKETING_VERSION = $(INPUTPILOT_VERSION)
CURRENT_PROJECT_VERSION = $(INPUTPILOT_BUILD)
